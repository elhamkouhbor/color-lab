{
  "name": "elham-color-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild.mjs dist",
    "build:pages": "tsc && ELHAM_BASE=/color-lab/ vite build && node scripts/postbuild.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser.mjs",
    "data": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "culori": "^4.0.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@radix-ui/colors": "^3.0.0",
    "@types/culori": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-scale-chromatic": "^3.1.0",
    "esbuild": "^0.21.5",
    "open-color": "^1.9.1",
    "playwright-core": "^1.55.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
